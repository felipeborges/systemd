#########################################
# ARM/AArch64 CPU Model Names
#########################################

# Format:
# cpu:*:implementer:XXXX:part:YYYY
#  ID_CPU_IMPLEMENTER=<Vendor Name>
#  ID_CPU_MODEL=<Model Name>
#
# The kernel does not expose CPU implementer/part IDs via the standard
# CPU modalias on ARM, only HWCAP feature bits. So we define our own
# hwdb identifier format based on /proc/cpuinfo data.

###########
# ARM Ltd.
###########

cpu:*:implementer:0x41:part:0xd03
 ID_CPU_IMPLEMENTER=ARM
 ID_CPU_MODEL=Cortex-A53

cpu:*:implementer:0x41:part:0xd04
 ID_CPU_IMPLEMENTER=ARM
 ID_CPU_MODEL=Cortex-A35

